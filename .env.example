# Copie para .env.local e preencha

# Banco Neon (Postgres): Neon Console > Connect > Connection string (use a conexão com pooler)
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Leitura de boleto por foto (OpenAI): platform.openai.com > API keys
OPENAI_API_KEY=sk-...
# Opcional: troca o modelo usado na leitura (padrão gpt-4.1)
# OPENAI_MODEL=gpt-4.1-mini

# Senha de acesso ao app e segredo para assinar o cookie de sessão
APP_SENHA=troque-esta-senha
SESSION_SECRET=gere-uma-string-longa-aleatoria

# Evolution API (WhatsApp com o chip dedicado)
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=chave-da-evolution
EVOLUTION_INSTANCE=peroba
# Número de destino com DDI+DDD, só dígitos. Ex.: 5511999998888
WHATSAPP_DESTINO=5511999998888
NOME_DESTINO=Dona Maria

# Lembretes: quantos dias antes e a partir de que hora (horário de Brasília)
LEMBRETE_DIAS=2
LEMBRETE_HORA=9
# Segredo para disparar /api/lembretes por cron externo (opcional)
CRON_SECRET=outro-segredo
